// Prisma schema for Digiseller Shop
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String?
  role         Role     @default(PARTNER)
  referralCode String   @unique @default(uuid())
  referredBy   String?
  balance      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  orders        Order[]
  referrals     User[]        @relation("Referrals")
  referrer      User?         @relation("Referrals", fields: [referredBy], references: [id])
  referralStats ReferralStat[]
}

enum Role {
  PARTNER
  ADMIN
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id                  String   @id @default(uuid())
  title               String
  description         String   @db.Text
  shortDesc           String?
  price               Decimal  @db.Decimal(10, 2)
  discountPrice       Decimal? @db.Decimal(10, 2)
  category            String
  tags                String[]
  imageUrl            String?
  images              String[] // Additional images
  digisellerProductId String   @unique
  isActive            Boolean  @default(true)
  salesCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Digiseller sync data
  digisellerSyncedAt   DateTime?
  digisellerSalesCount Int       @default(0)
  positiveReviews      Int       @default(0)
  negativeReviews      Int       @default(0)
  
  // Ranking system
  rankingScore         Float     @default(0)
  promotionLevel       Int       @default(0)  // 0=none, 1-3=promotion tier
  promotionExpiresAt   DateTime?
  viewsCount           Int       @default(0)

  // Relations
  orderItems OrderItem[]
}

// ============================================
// ORDERS
// ============================================

model Order {
  id                  String      @id @default(uuid())
  email               String      // Guest checkout - no user required
  userId              String?     // Optional - for tracking affiliate purchases
  totalAmount         Decimal     @db.Decimal(10, 2)
  status              OrderStatus @default(PENDING)
  paymentMethod       String?
  digisellerInvoiceId String?     @unique
  referralCode        String?     // Track which affiliate referred this order
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ============================================
// AFFILIATE / REFERRAL SYSTEM
// ============================================

model ReferralStat {
  id          String   @id @default(uuid())
  userId      String
  clicks      Int      @default(0)
  conversions Int      @default(0)
  earned      Decimal  @default(0) @db.Decimal(10, 2)
  date        DateTime @default(now()) @db.Date

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ============================================
// CATEGORIES (for filtering)
// ============================================

model Category {
  id          String @id @default(uuid())
  name        String @unique
  slug        String @unique
  description String?
  imageUrl    String?
  sortOrder   Int    @default(0)
  digisellerId Int?  @unique
}
